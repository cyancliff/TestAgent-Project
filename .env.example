# === Runtime ===
APP_ENV=development
AUTO_CREATE_TABLES=1

# === Database ===
# Preferred: set DATABASE_URL directly.
# DATABASE_URL=postgresql://postgres:change-this-postgres-password@localhost:5432/atmr_db
DB_USER=postgres
DB_PASSWORD=replace-with-a-strong-postgres-password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=atmr_db

# === Docker images / package mirrors ===
# If Docker Hub is slow, point POSTGRES_IMAGE to your own registry mirror.
POSTGRES_IMAGE=postgres:15-alpine
PYTHON_IMAGE=python:3.10-slim
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
PIP_DEFAULT_TIMEOUT=300
PIP_RETRIES=10
REQUIREMENTS_FILE=requirements_full.txt

# === JWT ===
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-strong-random-secret-key
ADMIN_USERNAMES=admin

# === CORS ===
ALLOWED_ORIGINS=*

# === AI keys ===
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_CHAT_THINKING=disabled
# Optional: switch analysis-heavy flows to deepseek-v4-pro if you prefer quality over latency/cost.
DEEPSEEK_ANALYSIS_MODEL=deepseek-v4-flash
DEEPSEEK_ANALYSIS_THINKING=disabled
DEEPSEEK_RAG_MODEL=deepseek-v4-flash
DEEPSEEK_RAG_RETRIEVE_MODEL=deepseek-v4-flash
DEEPSEEK_RAG_THINKING=disabled
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
