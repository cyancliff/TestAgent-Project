          "_Toc172571374",
          "_Toc172630739",
          "_Toc172623060",
          "_Toc3413",
          "_Toc172631524",
          "_Toc172626580"
        ]
      },
      {
        "id": "blk_80058",
        "order": 47,
        "nodeType": "p",
        "type": "paragraph",
        "level": 0,
        "styleId": "3",
        "text": "和图片不同，表格标签位于表格上方，插入表格时，先点“表格标签”，输入标签后按回车，再用表格工具插入表格。本文档已经配置三线表为默认插入的表格样式，但是列宽需要手动调整。",
        "owner": {
          "sectionId": "sec_80056"
        },
        "fields": [],
        "bookmarks": []
      },
      {
        "id": "blk_80059",
        "order": 48,
        "nodeType": "p",
        "type": "paragraph",
        "level": 0,
        "styleId": "3",
        "text": "插入表格流程",
        "owner": {
          "sectionId": "sec_80056"
        },
        "fields": [],
        "bookmarks": [
          "_Toc172631623"
        ]
      },
      {
        "id": "blk_80060",
        "order": 49,
        "nodeType": "p",
        "type": "paragraph",
        "level": 0,
        "styleId": "3",
        "text": "按Alt + =插入公式。",
        "owner": {
          "sectionId": "sec_80056"
        },
        "fields": [],
        "bookmarks": []
      },
      {
        "id": "blk_80061",
        "order": 50,
        "nodeType": "p",
        "type": "paragraph",
        "level": 0,
        "styleId": "3",
        "text": "在公式末尾按#。",
        "owner": {
          "sectionId": "sec_80056"
        },
        "fields": [],
        "bookmarks": []
      },
      {
        "id": "blk_80062",
        "order": 51,
        "nodeType": "p",
        "type": "paragraph",
        "level": 0,
        "styleId": "3",
        "text": "按Ctrl+F9插入域代码，在中括号内输入“ListNum equation \\l 6”（注意空格，以及\\后面是小写字母L），再按F9应用域代码。或者使用菜单中的插入域操作，具体见图。关于ListNum的具体原理，详见https://support.microsoft.com/en-us/office/field-codes-listnum-field-557541b1-abb2-4959-a9f2-401639c8ff82",
        "owner": {
          "sectionId": "sec_80056"
        },
        "fields": [
          "HYPERLINK \"https://support.microsoft.com/en-us/office/field-codes-listnum-field-557541b1-abb2-4959-a9f2-401639c8ff82\""
        ],
        "bookmarks": []
      },
      {
        "id": "blk_80063",
        "order": 52,
        "nodeType": "p",
        "type": "paragraph",
        "level": 0,
        "styleId": "3",
        "text": "按回车，编号会自动右对齐，并去掉编号的斜体样式。",
        "owner": {
          "sectionId": "sec_80056"
        },
        "fields": [],
        "bookmarks": []
